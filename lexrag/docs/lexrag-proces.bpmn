<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_lexrag" targetNamespace="http://lexrag.local/bpmn" exporter="lexrag docs/gen" exporterVersion="0.2.0">
  <bpmn:collaboration id="Collaboration_lexrag">
    <bpmn:participant id="Participant_wgranie" name="Wgranie aktu (indeksowanie, bez LLM)" processRef="Process_wgranie" />
    <bpmn:participant id="Participant_pytanie" name="Pytanie → odpowiedź" processRef="Process_pytanie" />
  </bpmn:collaboration>
  <bpmn:process id="Process_wgranie" isExecutable="false">
    <bpmn:startEvent id="S1" name="Plik aktu: PDF z ISAP, DOCX, HTML lub TXT">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="T1" name="Ekstrakcja tekstu po rozmiarze czcionki (przypisy i indeksy górne odpadają)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="T2" name="Parser struktury: dział, rozdział, art., ust., pkt; załączniki; uchylone; podwójne brzmienia">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="T3" name="Graf odesłań (wewnętrzne + do innych ustaw) i słownik definicji">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="T4" name="Lematyzacja (simplemma) i indeks BM25">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="T5" name="Embeddingi jednostek (mmlw-retrieval-roberta-large, lokalnie)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="T6" name="Zapis indeksu i statystyk: luki w numeracji, przypisy, duplikaty">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="E1" name="Indeks gotowy (jednostka = ustęp, z id np. fus:art138:ust3)">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F7" sourceRef="T6" targetRef="E1" />
  </bpmn:process>
  <bpmn:process id="Process_pytanie" isExecutable="false">
    <bpmn:laneSet id="LaneSet_pytanie">
      <bpmn:lane id="Lane_kod" name="Kod (deterministycznie)">
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_llm" name="LLM lokalny (Ollama)">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S2" name="Pytanie użytkownika (chat, ask, WWW)">
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G0" name="analiza pytania włączona?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T7" name="Analiza pytania: warianty zapytania, brakujące dane o sytuacji">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="brakuje danych?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Dopytanie użytkownika">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="T8" name="Wyszukiwanie hybrydowe: BM25 (lematy) + embeddingi, fuzja RRF, 50 kandydatów">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="T9" name="Reranking cross-encoderem (bge-reranker-v2-m3) → 8 najlepszych ustępów">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G2" name="jest kontekst i trafność ≥ próg?">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E3" name="Odmowa: brak pasującego przepisu">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="T10" name="Rozszerzenie kontekstu: cały artykuł, odesłania (1 skok), definicje; budżet 12 000 znaków">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="T11" name="Odpowiedź w JSON: tekst + id cytowanych przepisów (tylko id z kontekstu)">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="brak pokrycia lub brak cytatów?">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E4" name="Odmowa: sprawa dla referenta">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="T12" name="Kontrole deterministyczne: echo pytania, liczby spoza przepisów, odzysk cytatów z adresów">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="T13" name="Weryfikacja zdanie po zdaniu (werdykt dla każdego zdania) + czy odpowiedź jest na temat">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="na temat i ≥ 1 zdanie pokryte?">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E5" name="Odmowa: brak pokrycia lub nie na temat">
      <bpmn:incoming>F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="T14" name="Cytaty renderowane z indeksu po id (nie z modelu), czasy kroków">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="E6" name="Odpowiedź z cytatami i podstawą prawną">
      <bpmn:incoming>F28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F10" sourceRef="S2" targetRef="G0" />
    <bpmn:sequenceFlow id="F11" name="tak" sourceRef="G0" targetRef="T7" />
    <bpmn:sequenceFlow id="F12" name="nie" sourceRef="G0" targetRef="T8" />
    <bpmn:sequenceFlow id="F13" sourceRef="T7" targetRef="G1" />
    <bpmn:sequenceFlow id="F14" name="tak" sourceRef="G1" targetRef="E2" />
    <bpmn:sequenceFlow id="F15" name="nie" sourceRef="G1" targetRef="T8" />
    <bpmn:sequenceFlow id="F16" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="F17" sourceRef="T9" targetRef="G2" />
    <bpmn:sequenceFlow id="F18" name="nie" sourceRef="G2" targetRef="E3" />
    <bpmn:sequenceFlow id="F19" name="tak" sourceRef="G2" targetRef="T10" />
    <bpmn:sequenceFlow id="F20" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="F21" sourceRef="T11" targetRef="G3" />
    <bpmn:sequenceFlow id="F22" name="tak" sourceRef="G3" targetRef="E4" />
    <bpmn:sequenceFlow id="F23" name="nie" sourceRef="G3" targetRef="T12" />
    <bpmn:sequenceFlow id="F24" sourceRef="T12" targetRef="T13" />
    <bpmn:sequenceFlow id="F25" sourceRef="T13" targetRef="G4" />
    <bpmn:sequenceFlow id="F26" name="nie" sourceRef="G4" targetRef="E5" />
    <bpmn:sequenceFlow id="F27" name="tak" sourceRef="G4" targetRef="T14" />
    <bpmn:sequenceFlow id="F28" sourceRef="T14" targetRef="E6" />
  </bpmn:process>
