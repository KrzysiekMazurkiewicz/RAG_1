# --- LLM (serwer zgodny z API OpenAI). Puste LEXRAG_LLM_MODEL = tryb retrieval-only ---
LEXRAG_LLM_BASE_URL=http://localhost:11434/v1
LEXRAG_LLM_MODEL=                      # np. nazwa modelu w Ollamie po imporcie GGUF PLLuM/Bielik
LEXRAG_LLM_MODEL_SMALL=                # opcjonalnie mniejszy model do analizy pytania i weryfikacji
LEXRAG_LLM_TIMEOUT=300

# --- embeddingi (sentence-transformers) ---
LEXRAG_EMB_MODEL=sdadas/mmlw-retrieval-roberta-large
LEXRAG_EMB_QUERY_PREFIX=zapytanie:     # mmlw: "zapytanie: " ; bge-m3: "" ; e5: "query: "
LEXRAG_EMB_DOC_PREFIX=                 # e5: "passage: "
LEXRAG_DISABLE_EMB=0

# --- reranker ---
LEXRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LEXRAG_DISABLE_RERANKER=0

# --- retrieval ---
LEXRAG_K_EACH=30
LEXRAG_RRF_K=60
LEXRAG_TOP_N=8
LEXRAG_MAX_CTX_CHARS=12000             # ~4 tys. tokenów; na CPU to główny koszt (prefill)
